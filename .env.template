# =============================================================================
# Bot environment variables (for running locally)
#
#   cp .env.template .env      then replace each REPLACE_ME with a real key.
#
# Never commit `.env`. On GitHub, put keys under
#   Settings -> Secrets and variables -> Actions -> Secrets
# and the optional settings further down under
#   Settings -> Secrets and variables -> Actions -> Variables
# =============================================================================


# ---- REQUIRED -----------------------------------------------------------------
# Token of your Metaculus BOT account (not your personal account).
# https://www.metaculus.com/futureeval/participate/
METACULUS_TOKEN=REPLACE_ME

# OpenRouter key. All default models (OpenAI, Anthropic, Google, Perplexity) go
# through it. Tip: give the key a credit limit on openrouter.ai.
OPENROUTER_API_KEY=REPLACE_ME


# ---- OPTIONAL: news search ----------------------------------------------------
# Free for FutureEval participants (email contact@asknews.app). Turned on
# automatically when the credentials are set.
# ASKNEWS_CLIENT_ID=REPLACE_ME
# ASKNEWS_SECRET=REPLACE_ME
# ...or, if the AskNews console gives you a single key:
# ASKNEWS_API_KEY=REPLACE_ME


# ---- OPTIONAL: bot settings (defaults shown) ----------------------------------
# standard = gpt-6.2-sol + claude-opus-5.5 + gemini-4-argon (~$0.4-0.6 per question)
# budget   = gpt-6.1-terra + claude-sonnet-5.5 + gemini-3.8-flash (~$0.15-0.25 per question)
# BOT_PROFILE=standard

# Override the ensemble. Comma-separated OpenRouter slugs; "a|b" = use b if a fails.
# FORECASTER_MODELS=openrouter/openai/gpt-6.2-sol,openrouter/anthropic/claude-opus-5.5,openrouter/google/gemini-4-argon|openrouter/google/gemini-3.8-flash

# Web-search models used for research ("none" to switch off).
# RESEARCH_MODELS=openrouter/openai/gpt-6.1-terra:online,openrouter/perplexity/sonar-pro

# SAMPLES_PER_MODEL=1          # forecasts per model per question
# REASONING_EFFORT=high        # low / medium / high / none (budget profile defaults to medium)
# MAX_QUESTIONS_PER_RUN=15     # cost guard per run; the rest wait for the next run
# MIN_MINUTES_BEFORE_CLOSE=6   # skip questions that close sooner than this
# FETCH_RESOLUTION_SOURCES=true
# TOURNAMENT_IDS=              # override the tournaments for --mode tournament (ids or slugs)
